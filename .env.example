# =============================================================================
# Event Management System — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
SECRET_KEY=your-secret-key-change-in-production-use-at-least-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.development

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DB_NAME=eventmanagement
DB_USER=eventuser
DB_PASSWORD=eventpassword
DB_HOST=db
DB_PORT=5432
# Or use DATABASE_URL directly:
# DATABASE_URL=postgres://eventuser:eventpassword@db:5432/eventmanagement

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Email (SMTP / SendGrid / SES)
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@eventmanagement.com
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# AWS S3 (for production file storage)
# Set USE_S3=True in production
# -----------------------------------------------------------------------------
USE_S3=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# -----------------------------------------------------------------------------
# Payment Providers
# -----------------------------------------------------------------------------

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CURRENCY=usd

# SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_pass
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com

# bKash
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_IS_SANDBOX=True

# Nagad
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=your_nagad_private_key
NAGAD_PGW_PUBLIC_KEY=your_nagad_pgw_public_key
NAGAD_IS_SANDBOX=True

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# Site Configuration
# -----------------------------------------------------------------------------
SITE_NAME=EventManagement
SITE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Tax / Fees
# -----------------------------------------------------------------------------
TAX_RATE=0.00
SERVICE_FEE_RATE=0.02

# -----------------------------------------------------------------------------
# Sentry (Production Error Tracking)
# -----------------------------------------------------------------------------
SENTRY_DSN=
